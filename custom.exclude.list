# /etc/penguins-eggs.d/custom.exclude.list
# Custom exclusions for live ISO generation.
# Paths listed below are excluded from filesystem.squashfs.
# Comment the line (prepend '#') to include it on the live system.

# ==========================================
# DOCKER & CONTAINERD
# ==========================================
var/lib/docker/
var/lib/containerd/
home/*/.docker/

# ==========================================
# PODMAN & ALTRI GESTORI CONTAINER
# (LXC, LXD, systemd-nspawn)
# ==========================================
var/lib/containers/
home/*/.local/share/containers/
var/lib/lxc/
var/lib/lxd/
var/lib/machines/

# ==========================================
# SNAPD (Pacchetti Snap)
# ==========================================
var/lib/snapd/
var/snap/
snap/

# Force Include
!motivnavi
!motivnavi/**

# ==========================================
# MOTIVNAVI: ビルドの途中生成物（約2.4GB）
# アプリを build/ や target/ から直接起動していないことを
# 確認してから、行頭の '#' を外して有効にしてください。
# ==========================================
motivnavi/fcitx5-osk-ja/build/
motivnavi/fcitx5-osk-ja/build-deb/
motivnavi/mediablue/src-tauri/target/
opt/motivnavi/fcitx5-osk-ja/build-deb/
opt/motivnavi/mediablue/src-tauri/target/